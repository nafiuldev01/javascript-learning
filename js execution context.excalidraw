    {
      "id": "QZH_89zDB1aIPl1OkbzMa",
      "type": "text",
      "x": 328.5649991122151,
      "y": 3112.909090909091,
      "width": 1455.8135986328125,
      "height": 172.90909090909085,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
